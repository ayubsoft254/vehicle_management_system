# =============================================================================
# Vehicle Management System — Environment Variables
# Copy this file to .env and fill in the real values.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Django Core
# -----------------------------------------------------------------------------
SECRET_KEY=replace-with-a-long-random-string-50-chars-minimum
DEBUG=False
# Allowed hosts are locked down in settings.py (taifaassist.xyz, localhost,
# 127.0.0.1, hozacars.com, www.hozacars.com). To change which domains can
# reach the server, edit ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS there.

# -----------------------------------------------------------------------------
# Database — PostgreSQL (used by docker-compose and DATABASE_URL)
# -----------------------------------------------------------------------------
DB_NAME=vms_db
DB_USER=vms_user
DB_PASSWORD=change-this-strong-password

# Full connection URL — used directly by Django via dj-database-url.
# When running inside Docker the host is the service name "db".
DATABASE_URL=postgresql://vms_user:change-this-strong-password@db:5432/vms_db

# -----------------------------------------------------------------------------
# Redis (Celery broker + result backend)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Email — Gmail SMTP example (use an App Password, not your real password)
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=your-gmail@gmail.com

# -----------------------------------------------------------------------------
# M-Pesa Daraja (paybill tracking + STK push)
# Set MPESA_ENV=production when going live.
# -----------------------------------------------------------------------------
MPESA_ENV=production
MPESA_CONSUMER_KEY=your-daraja-consumer-key
MPESA_CONSUMER_SECRET=your-daraja-consumer-secret

# Primary paybill — used for STK push and balance checks.
MPESA_SHORTCODE=4320049

MPESA_PASSKEY=your-daraja-passkey
MPESA_INITIATOR_NAME=your-api-initiator-username
MPESA_SECURITY_CREDENTIAL=your-encrypted-security-credential

# Base URL Daraja will call back to — must be publicly reachable (no trailing slash)
MPESA_RESULT_URL_BASE=https://hozacars.com

# Optional shared secret to validate incoming Daraja callbacks
MPESA_CALLBACK_SECRET=

# C2B callback URLs registered with Safaricom (must match what you registered)
MPESA_C2B_CONFIRMATION_URL=https://hozacars.com/payments/paybill/callbacks/confirmation/
MPESA_C2B_VALIDATION_URL=https://hozacars.com/payments/paybill/callbacks/validation/
MPESA_STK_CALLBACK_URL=https://hozacars.com/payments/mpesa-callback/

# -----------------------------------------------------------------------------
# Secondary paybill — DIFFERENT Safaricom account, so needs its own credentials.
# Only CONSUMER_KEY and CONSUMER_SECRET are needed (no passkey/initiator — C2B tracking only).
# After deployment, click "Register Callbacks" in /payments/paybill/ and it will
# register BOTH paybills with their respective credentials automatically.
MPESA_SHORTCODE_2=4162495
MPESA_CONSUMER_KEY_2=second-account-consumer-key
MPESA_CONSUMER_SECRET_2=second-account-consumer-secret

# Optional — only needed if paybill 2 is reachable on its own domain. Without
# these, paybill 2 falls back to the primary paybill's MPESA_*_URL above,
# which registers the wrong domain with Safaricom for this shortcode.
MPESA_C2B_CONFIRMATION_URL_2=https://your-second-domain/payments/paybill2/callbacks/confirmation/
MPESA_C2B_VALIDATION_URL_2=https://your-second-domain/payments/paybill2/callbacks/validation/
MPESA_STK_CALLBACK_URL_2=https://your-second-domain/payments/mpesa-callback2/
MPESA_BALANCE_RESULT_URL_2=https://your-second-domain/payments/paybill2/callbacks/balance-result/
MPESA_BALANCE_TIMEOUT_URL_2=https://your-second-domain/payments/paybill2/callbacks/balance-timeout/

# Twilio SMS (optional — leave blank to disable SMS)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# -----------------------------------------------------------------------------
# DocuSeal E-Signature (optional — leave blank to disable)
# -----------------------------------------------------------------------------
DOCUSEAL_BASE_URL=
DOCUSEAL_API_KEY=
DOCUSEAL_DEFAULT_SIGNER_ROLE=Signer
DOCUSEAL_TIMEOUT_SECONDS=20

# -----------------------------------------------------------------------------
# Company Information (printed on PDFs and agreements)
# -----------------------------------------------------------------------------
COMPANY_NAME=Hoza Cars
COMPANY_ADDRESS=Nairobi, Kenya
COMPANY_PHONE=+254-700-000-000
COMPANY_EMAIL=info@hozacars.com
COMPANY_WEBSITE=www.hozacars.com
