{% load static %}{
    "name": "{{ brand.app_name|escapejs }}",
    "short_name": "{{ brand.app_name|escapejs }}",
    "description": "Vehicle sales, client and finance management for {{ brand.public_name|escapejs }}.",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "orientation": "portrait-primary",
    "theme_color": "{{ theme.primary.600 }}",
    "background_color": "#f9fafb",
    "icons": [
        {
            "src": "{% static 'pwa/icon-192.png' %}",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "{% static 'pwa/icon-512.png' %}",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "{% static 'pwa/icon-maskable-512.png' %}",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "shortcuts": [
        {
            "name": "Dashboard",
            "url": "/dashboard/",
            "icons": [{ "src": "{% static 'pwa/icon-192.png' %}", "sizes": "192x192" }]
        },
        {
            "name": "Payments",
            "url": "/payments/",
            "icons": [{ "src": "{% static 'pwa/icon-192.png' %}", "sizes": "192x192" }]
        },
        {
            "name": "Clients",
            "url": "/clients/list/",
            "icons": [{ "src": "{% static 'pwa/icon-192.png' %}", "sizes": "192x192" }]
        }
    ]
}
